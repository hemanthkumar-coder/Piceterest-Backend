# Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copy the project file
COPY ["Picterest/Picterest.csproj", "Picterest/"]

# Restore dependencies
RUN dotnet restore "Picterest/Picterest.csproj"

# Copy the entire source code
COPY . .

# Build the application
WORKDIR "/src/Picterest"
RUN dotnet build "Picterest.csproj" -c Release -o /app/build

# Publish stage
FROM build AS publish
RUN dotnet publish "Picterest.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy published application from publish stage
COPY --from=publish /app/publish .

# Create logs directory
RUN mkdir -p /app/Logs

# Set environment variables
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

# Expose port
EXPOSE 5000


# Set non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Run the application
ENTRYPOINT ["dotnet", "Picterest.dll"]
